{
    "name": "@st-hiring/backend",
    "description": "seetickets-core project",
    "license": "UNLICENSED",
    "private": true,
    "homepage": "https://github.com/Flavorus/st-hiring-backend",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Flavorus/st-hiring-backend.git"
    },
    "scripts": {
        "start": "yarn nodemon src/index.ts",
        "dev": "nodemon src/index.ts",
        "test": "vitest run",
        "migrations:make": "yarn knex migrate:make --migrations-directory src/database/migrations ",
        "migrations:latest": "yarn knex migrate:latest --knexfile ./src/knexfile.ts --migrations-directory ./database/migrations",
        "migrations:down": "yarn knex migrate:down --knexfile ./src/knexfile.ts --migrations-directory ./database/migrations",
        "db:seed": "yarn knex seed:run --knexfile ./src/knexfile.ts --migrations-directory ./database/seeds",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
        "@opentelemetry/instrumentation-express": "^0.72.0",
        "@opentelemetry/instrumentation-http": "^0.300.0",
        "@opentelemetry/instrumentation-mongodb": "^0.77.0",
        "@opentelemetry/instrumentation-pg": "^0.77.0",
        "@opentelemetry/sdk-node": "^0.300.0",
        "@st-hiring/shared": "workspace:*",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "4.19.2",
        "knex": "^3.1.0",
        "mongodb": "^6.8.0",
        "pg": "^8.12.0",
        "yup": "^1.4.0"
    },
    "devDependencies": {
        "@faker-js/faker": "^8.4.1",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "^2.1.9",
        "eslint": "^9.6.0",
        "nodemon": "^3.1.4",
        "prettier": "3.3.2",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "typescript": "5.5.2",
        "vitest": "^2.1.9"
    }
}
